generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourtSurface {
  HARD
  CLAY
  GRASS
  OTHER
}

enum CourtEnvironment {
  INDOOR
  OUTDOOR
}

enum Sport {
  TENNIS
  PICKLEBALL
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  COUNTER
}

enum PaymentStatus {
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum ResidentStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities Facility[]
  users      User[]
}

model Facility {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timezone       String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  courts       Court[]
  closures     FacilityClosure[]
  reservations Reservation[]

  @@index([organizationId])
}

model Court {
  id          String           @id @default(cuid())
  facilityId  String
  name        String
  environment CourtEnvironment
  surface     CourtSurface
  sports      Sport[]
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  facility     Facility      @relation(fields: [facilityId], references: [id])
  reservations Reservation[]

  @@index([facilityId])
}

model User {
  id             String         @id @default(cuid())
  organizationId String?
  email          String?        @unique
  phone          String?        @unique
  displayName    String?
  residentStatus ResidentStatus @default(NONE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  reservations  Reservation[]
  auditEvents   AuditEvent[]

  @@index([organizationId])
}

model Reservation {
  id          String            @id @default(cuid())
  facilityId  String
  courtId     String
  userId      String?
  status      ReservationStatus @default(HOLD)

  startAt     DateTime
  endAt       DateTime

  amountCents Int     @default(0)
  currency    String  @default("USD")

  qrToken     String? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  facility    Facility @relation(fields: [facilityId], references: [id])
  court       Court    @relation(fields: [courtId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  payments    Payment[]
  refunds     Refund[]

  @@index([facilityId, startAt, endAt])
  @@index([courtId, startAt, endAt])
}

model Payment {
  id                    String          @id @default(cuid())
  reservationId         String
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amountCents           Int
  currency              String          @default("USD")
  stripePaymentIntentId String?         @unique

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  reservation           Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

model Refund {
  id            String   @id @default(cuid())
  reservationId String
  paymentId     String?
  amountCents   Int
  currency      String   @default("USD")
  reason        String?
  createdAt     DateTime @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

model FacilityClosure {
  id         String   @id @default(cuid())
  facilityId String
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())

  facility   Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, startAt, endAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User? @relation(fields: [userId], references: [id])

  @@index([userId])
}