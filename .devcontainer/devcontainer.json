{
  "name": "CourtFlow Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm i -g pnpm@9 && pnpm install",
  "postStartCommand": "pnpm -C apps/web dev --port 3000",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "CourtFlow web",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma"
      ]
    }
  }
}
